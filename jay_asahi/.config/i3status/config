general {
    output_format = "i3bar"
    colors = true
    color_good = "#e0def4"
    color_degraded = "#f6c177"
    color_bad = "#eb6f92"
}

order += "volume master"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "tztime local"

volume master {
    format = "%volume 󰕾"
    format_muted = "󰝟"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

ethernet _first_ {
    format_up = ""
    format_down = "Disconnected ⚠"
}

cpu_usage {
    format = "%usage 󰻠"
}

memory {
    format = "%percentage_used 󰍛"
    threshold_degraded = "10%"
    threshold_critical = "5%"
}

tztime local {
    format = "%a %b %d %H:%M"
}
